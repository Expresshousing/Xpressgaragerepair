# Copy to .env, fill in what you want, then run:  node --env-file=.env server.mjs
# Each channel switches on by itself when its settings are filled in. Leave a line blank to keep it off.

PORT=4190
ADMIN_PASSWORD=change-this-to-a-long-random-password
SITE_URL=https://www.your-domain.com        # used for links inside emails/texts

# --- Email via Resend (https://resend.com): staff alerts + customer emails ---
RESEND_API_KEY=
ALERT_EMAIL_FROM=Xpress Garage Doors <alerts@your-domain.com>   # a sender on a domain you verified in Resend
ALERT_EMAIL_TO=owner@your-domain.com,dispatch@your-domain.com   # who is alerted (comma separated)
ALERT_REPLY_TO=info@xpressgaragedoorservics.com                 # where customer replies go
CUSTOMER_EMAILS=on                                              # "off" = alert staff only, never email customers

# --- Text messages via Twilio (https://twilio.com): staff alerts ---
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=+1XXXXXXXXXX
ALERT_SMS_TO=+12153971926,+1XXXXXXXXXX

# --- Slack / Discord / Zapier webhook (optional) ---
ALERT_WEBHOOK_URL=

# --- Card payments via Stripe (https://stripe.com) ---
STRIPE_SECRET_KEY=sk_live_or_sk_test_...      # Developers > API keys. Start with a sk_test_ key.
STRIPE_WEBHOOK_SECRET=whsec_...                # Developers > Webhooks: add endpoint  SITE_URL/api/stripe/webhook  for event checkout.session.completed

# --- Reviews and reminders ---
REVIEW_GOOGLE_URL=https://g.page/r/YOUR-ID/review   # your Google review link (Google Business Profile > Ask for reviews). Blank = no Google button.
REVIEW_DELAY_HOURS=4                                 # how long after "completed" the review email goes out
MAINTENANCE_MONTHS=12                                # yearly check-up reminder; 0 = off
